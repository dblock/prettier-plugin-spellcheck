{
  "name": "prettier-plugin-spellcheck",
  "version": "0.1.0",
  "description": "Markdown spelling checks and opt-in autocorrection for Prettier, powered by CSpell.",
  "type": "module",
  "main": "src/index.mjs",
  "exports": "./src/index.mjs",
  "bin": {
    "prettier-plugin-spellcheck": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "coverage": "c8 --all --include='src/*.mjs' --reporter=text --reporter=lcov node --test",
    "lint": "eslint . && prettier --check .",
    "test": "node --test"
  },
  "keywords": [
    "prettier",
    "prettier-plugin",
    "markdown",
    "spellcheck",
    "cspell"
  ],
  "author": "Daniel Doubrovkine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/prettier-plugin-spellcheck.git"
  },
  "bugs": {
    "url": "https://github.com/dblock/prettier-plugin-spellcheck/issues"
  },
  "homepage": "https://github.com/dblock/prettier-plugin-spellcheck#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "prettier": ">=3.7.0 <4"
  },
  "dependencies": {
    "@cspell/dict-en_us": "^4.4.43",
    "cspell-dictionary": "^10.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cspell/dict-es-es": "^3.0.9",
    "@cspell/dict-software-terms": "^5.4.8",
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10"
  }
}
